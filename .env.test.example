# Used by Vitest integration tests and Playwright E2E. Must point at a database whose name contains "_test";
# the test setup creates and migrates it automatically.
DATABASE_URL="postgresql://postgres:password@localhost:5432/gameshelf_test?schema=public"

AUTH_SECRET="any-random-string"

# E2E talks to the real RAWG API
RAWG_API_KEY=""

AUTH_TRUST_HOST=true
