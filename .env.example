# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/gameshelf"

# Auth.js secret, generate with: npx auth secret
AUTH_SECRET=""

# RAWG API key: https://rawg.io/apidocs
RAWG_API_KEY=""

# Public URL of the site, used for absolute Open Graph image links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Needed when self-hosting with `next start` (Vercel sets this automatically)
# AUTH_TRUST_HOST=true
