# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/gameshelf"

# Auth.js secret, generate with: npx auth secret
AUTH_SECRET=""

# RAWG API key: https://rawg.io/apidocs
RAWG_API_KEY=""

# GitHub OAuth app: https://github.com/settings/developers
GITHUB_ID=""
GITHUB_SECRET=""

# Google OAuth client: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Needed when self-hosting with `next start` (Vercel sets this automatically)
# AUTH_TRUST_HOST=true
